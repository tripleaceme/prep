# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Real environment files never get committed. The .env.local.example template
# must, because DEPLOY.md tells you to copy it — Next's default `.env*` was
# swallowing it. The negation is deliberately narrow: a broader `!.env*.example`
# let a Finder duplicate ("\.env copy.example") slip into the repo.
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local environment
.env
.env.local
# The API has no .env template on purpose: credentials belong in
# api/config.local.php, because a .env in the web root is served as text.
api/.env

# Live API credentials. The .example template IS committed.
# "* copy*" catches Finder duplicates, which have twice now slipped a stray
# template into the repo under a name the specific rules didn't cover.
api/config.local.php
!api/config.local.php.example
*\ copy*

# Reference screenshots — competitor UI, not ours to ship
/update/

# Upload archives. A zip of the api/ folder picks up whatever is sitting in it,
# including a real .env — which is exactly how credentials got committed once.
*.zip
