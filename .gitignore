# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Real environment files never get committed. The *.example templates must,
# because DEPLOY.md tells you to copy them — Next's default `.env*` was
# swallowing them.
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local environment
.env
.env.local
api/.env
!api/.env.example

# Reference screenshots — competitor UI, not ours to ship
/update/
