# Prep (Next.js on Vercel) — copy to .env.local and fill in.

# The PHP API on go54. No trailing slash.
PREP_API_URL=https://behindthedata.tech/api

# Must match API_SHARED_SECRET in api/.env on go54, exactly.
# Generate with:  openssl rand -hex 32
API_SHARED_SECRET=

# Signs the session cookie. Independent of the API secret; rotating it logs
# everyone out, which is the intended emergency lever.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Public origin of the deployed app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: there is deliberately no AI provider key here. Prep calls Gemini from
# the browser using the key each user supplies, which is why the app costs
# nothing to run and why no interview content reaches our servers.

# ---------------------------------------------------------------------------
# Analytics (prep.behindthedata.tech/analytics)
#
# Operator credentials, entirely separate from user accounts. There is no admin
# row in the database, so there is nothing to find or escalate to.
# Generate the hash with:  node scripts/make-admin-password.mjs 'your-password'
# ---------------------------------------------------------------------------
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD_HASH=
