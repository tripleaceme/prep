# Prep API — copy to api/.env on go54 and fill in. Never commit the real file.

# cPanel MySQL. Keep Remote MySQL DISABLED: this connects over localhost.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yourcpaneluser_prep
DB_USER=yourcpaneluser_prep
DB_PASS=

# Must match API_SHARED_SECRET in the Next.js environment, exactly.
# Generate with:  openssl rand -hex 32
API_SHARED_SECRET=

# Where the Next.js app lives.
APP_URL=https://prep.behindthedata.tech

# Sender for the password-reset email.
MAIL_FROM="Prep <no-reply@behindthedata.tech>"

# Strongly recommended. Without it, resets fall back to PHP mail(), which
# shared hosts routinely get filtered to spam — and a filtered reset link is a
# permanently locked account. Leave blank only until your sending domain is
# verified with Resend.
RESEND_API_KEY=
